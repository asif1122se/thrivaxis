# Resend (https://resend.com) — used by src/app/api/contact/route.ts
# Create an API key under Settings > API Keys and paste it below.
# Note: In development mode (npm run dev), if RESEND_API_KEY is omitted,
# form submissions will log locally to the server console instead of throwing errors.
RESEND_API_KEY=

# Optional: Override the recipient email address for intake notifications in testing
RESEND_TO_EMAIL="company@thrivaxis.com"

# Optional: Once your sending domain is verified in Resend, switch this to
# something like "Thrivaxis <company@thrivaxis.com>". Until then it falls back
# to Resend's shared testing address (onboarding@resend.dev).
RESEND_FROM_EMAIL="Thrivaxis <onboarding@resend.dev>"
