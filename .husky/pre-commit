# Add common terminal/package paths to $PATH for GUI git clients like GitHub Desktop
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/share/pnpm:$PATH"

# Load NVM if it exists
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -f .nvmrc ] && nvm use --silent >/dev/null 2>&1 || true

# Run lint-staged if pnpm is available, otherwise warn and proceed with the commit
if command -v pnpm >/dev/null 2>&1; then
  pnpm lint-staged
else
  echo "WARNING: pnpm command not found in PATH. Skipping lint-staged check."
fi
